# Asset Intelligence Copilot - Environment Configuration Example
# Copy this file to .env and configure as needed. Never commit .env to version control!

# Dataset Location (Optional, defaults to ../flytbase-ahc-swe-asset-intelligence-dataset)
# DATASET_ROOT=C:\Users\Admin\flytbase-ahc-swe-asset-intelligence-dataset

# LLM Synthesis Layer Configuration
# Set to true to enable natural-language answer synthesis
LLM_ENABLED=false

# Supported providers: "gemini" (default) or "openai"
LLM_PROVIDER=gemini

# Model names
# Gemini: "gemini-2.5-flash", "gemini-1.5-flash", etc.
# OpenAI: "gpt-4o-mini", "gpt-4o", etc.
LLM_MODEL=gemini-2.5-flash

# Provider request timeout in seconds
LLM_TIMEOUT_SECONDS=10.0

# API Credentials (leave empty if LLM_ENABLED=false)
# For Gemini provider:
GEMINI_API_KEY=
# Or GOOGLE_API_KEY=

# For OpenAI provider:
OPENAI_API_KEY=
